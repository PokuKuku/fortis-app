{
  "expo": {
    "name": "Fortis",
    "slug": "fortis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fortis_icon_sparkle_toned_down.png",
    "notification": {
      "icon": "./assets/fortis_icon_sparkle_toned_down.png",
      "color": "#0a0a0a"
    },
    "scheme": "fortis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fortisfitness.app",
      "usesAppleSignIn": true,
      "icon": "./assets/fortis_icon_sparkle_toned_down.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fortis_icon_sparkle_toned_down.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.fortis.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 21
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
