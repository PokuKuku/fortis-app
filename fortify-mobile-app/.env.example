# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-privacy-policy-url
EXPO_PUBLIC_TERMS_URL=https://your-terms-url
# Superwall iOS local StoreKit toggle (set to true only for simulator/local testing)
EXPO_PUBLIC_BYPASS_APP_TRANSACTION_CHECK=false

# RevenueCat analytics-only integration
# React Native uses app-specific public SDK keys per platform.
# Never ship a test_store `test_...` key to TestFlight or App Store builds.
# Optional shared fallback only works when it matches the current platform prefix (`appl_` for iOS, `goog_` for Android).
# EXPO_PUBLIC_REVENUECAT_API_KEY=
# App-specific public SDK keys from RevenueCat Project Settings > API keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-ios-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-android-public-sdk-key

# Mixpanel analytics
EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-project-token
# Optional for EU data residency: https://api-eu.mixpanel.com
EXPO_PUBLIC_MIXPANEL_SERVER_URL=https://api.mixpanel.com

# ExerciseDB API (RapidAPI)
# Get your API key from https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
EXPO_PUBLIC_EXERCISEDB_API_KEY=your-rapidapi-key-here
