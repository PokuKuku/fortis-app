{
  "expo": {
    "name": "Fortify AI",
    "slug": "fortis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fortis_ai_icon.png",
    "notification": {
      "icon": "./assets/fortis_ai_icon.png",
      "color": "#121214"
    },
    "scheme": "fortis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#121214"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fortisfitness.app",
      "usesAppleSignIn": true,
      "icon": "./assets/fortis_ai_icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "FortifyAI",
        "CFBundleName": "FortifyAI",
        "NSMicrophoneUsageDescription": "Fortify uses your microphone so you can dictate workout sets, weights, and reps during an active session.",
        "NSPhotoLibraryUsageDescription": "Turning on Photo access will allow us to display your chosen photo for your profile.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.fortisfitness.app.delete-feedback",
            "UIApplicationShortcutItemTitle": "Deleting? Tell us why.",
            "UIApplicationShortcutItemSubtitle": "Send feedback before you delete.",
            "UIApplicationShortcutItemIconSymbolName": "square.and.pencil"
          }
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fortis_ai_icon.png",
        "backgroundColor": "#121214"
      },
      "package": "com.fortis.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/fortis_ai_icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 21
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
