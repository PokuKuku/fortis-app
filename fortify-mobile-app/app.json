{
  "expo": {
    "name": "Fortify",
    "slug": "fortis",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/fortify_new_icon.png",
    "notification": {
      "icon": "./assets/fortify_new_icon.png",
      "color": "#24252A"
    },
    "scheme": "fortis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#24252A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fortisfitness.app",
      "buildNumber": "8",
      "usesAppleSignIn": true,
      "icon": "./assets/fortify_new_icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "Fortify",
        "CFBundleName": "FortifyAI",
        "NSMicrophoneUsageDescription": "Fortify uses your microphone so you can dictate messages to the AI assistant.",
        "NSSpeechRecognitionUsageDescription": "Fortify uses speech recognition so your voice messages can appear as text while you speak.",
        "NSPhotoLibraryUsageDescription": "Fortify uses Photo access for profile pictures and to attach photos or videos to AI chat.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.fortisfitness.app.delete-feedback",
            "UIApplicationShortcutItemTitle": "Deleting? Tell us why.",
            "UIApplicationShortcutItemSubtitle": "Send feedback before you delete.",
            "UIApplicationShortcutItemIconSymbolName": "square.and.pencil"
          }
        ],
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fortify_new_icon.png",
        "backgroundColor": "#24252A"
      },
      "package": "com.fortis.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.android.vending.BILLING"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/fortify_new_icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-video",
      "expo-localization",
      "./plugins/withSuperwallXcode26Fix",
      "./plugins/withStartWorkoutWidget",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 21
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Fortify uses your microphone so you can dictate messages to the AI assistant.",
          "speechRecognitionPermission": "Fortify uses speech recognition so your voice messages can appear as text while you speak."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1df7f09e-a068-4bb3-814b-72c36906b512"
      }
    },
    "owner": "pokukuku"
  }
}
